{"id": "write-code", "sample": 0, "malformed": "", "fidelity": "", "wall_s": 0.71, "completion_tokens": 321, "finish": "tool_calls", "decode_tok_s": 497.4, "tool_calls": [{"id": "call_7275f092f07d4da0a74f3327", "type": "function", "function": {"name": "write_file", "arguments": "{\"content\":\"import json, re, sys\\n\\nPATTERN = re.compile(r'^(?P<key>[\\\\w.-]+)\\\\s*=\\\\s*\\\"(?P<val>(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"$')\\n\\ndef parse(text: str) -> dict:\\n    \\\"\\\"\\\"key = \\\"value\\\" lines -> dict; '#' starts a comment.\\\"\\\"\\\"\\n    out = {}\\n    for n, line in enumerate(text.splitlines(), 1):\\n        line = line.split('#', 1)[0].strip()\\n        if not line:\\n            continue\\n        m = PATTERN.match(line)\\n        if m is None:\\n            raise ValueError(f\\\"line {n}: cannot read {line!r}\\\")\\n        out[m['key']] = bytes(m['val'], 'utf-8').decode('unicode_escape')\\n    return out\\n\\n\\ndef main(argv):\\n    data = parse(open(argv[1], encoding='utf-8').read())\\n    print(json.dumps(data, ensure_ascii=False, indent=2))\\n    print('\\u043a\\u043b\\u044e\\u0447\\u0435\\u0439:', len(data), '\\\\t(\\u0433\\u043e\\u0442\\u043e\\u0432\\u043e)')\\n    return 0\\n\\n\\nif __name__ == '__main__':\\n    sys.exit(main(sys.argv))\\n\",\"path\":\"tools/kv_parse.py\"}"}}], "content": ""}
